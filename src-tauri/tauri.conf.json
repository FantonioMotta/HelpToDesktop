{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HelpBar Desktop",
  "version": "0.1.1",
  "identifier": "com.helpbar.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HelpBar Desktop",
        "width": 560,
        "height": 72,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "HelpBar",
    "copyright": "© 2026 HelpBar. Todos os direitos reservados.",
    "category": "Productivity",
    "shortDescription": "Barra de produtividade flutuante para Windows 11",
    "longDescription": "HelpBar Desktop reúne agenda, tarefas, notas e lembretes em uma barra flutuante sempre acessível no topo da tela, com dados armazenados localmente.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "HelpBar",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/FantonioMotta/HelpToDesktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3QjU0RDJGRUI3MkEwM0IKUldRN29ITHJMMDIxcDFiQUxuTENSSkJTZjErOGozM0tmNlBpZ2piTUpVWUdGRldZUWRESndaOVEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
